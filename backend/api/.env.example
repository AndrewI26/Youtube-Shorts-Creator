# Copy to .env and adjust. Loaded with: uv run --env-file .env uvicorn app.main:app
# Every value is optional; the defaults are shown.

# Postgres connection URL. The default matches compose.yaml (docker compose up -d).
# postgres:// and postgresql:// URLs are accepted and use the psycopg 3 driver.
# DATABASE_URL=postgresql+psycopg://shorts:shorts@localhost:5433/shorts

# Server used by the test suite; each run creates and drops its own database on it.
# TEST_DATABASE_URL=postgresql+psycopg://shorts:shorts@localhost:5433/postgres

# Where per-request working files (narration, rendered video) are written
# MEDIA_DIR=media

# Folder containing SubwaySurfers.mov, MinecraftParkor.mov and MobileGamplay.mov
# BACKGROUNDS_DIR=assets/backgrounds

# faster-whisper model used for captions: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# ImageMagick font name, or a path to a font file.
# On macOS, "Futura-Bold" often isn't found by name; a path is more reliable.
CAPTION_FONT=/System/Library/Fonts/Supplemental/Futura.ttc

# Comma-separated origins allowed to call the API, or * for any
CORS_ORIGINS=http://localhost:3000
